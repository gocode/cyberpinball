{
  "name": "cyberpinball",
  "version": "0.1.5-essai.13",
  "private": true,
  "description": "Open-source frontend for virtual pinball cabinets on Windows. Describe your cabinet once (screens, buttons, sound) and Cyber Pinball configures and maintains Visual Pinball X for you: screens recognised by EDID, a wizard driven by the cabinet buttons, table and media management, signed in-app updates.",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "virtual-pinball",
    "visual-pinball",
    "visual-pinball-x",
    "vpx",
    "pinball",
    "pinball-cabinet",
    "pincab",
    "pinball-frontend",
    "frontend",
    "electron",
    "typescript",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gocode/cyberpinball.git"
  },
  "workspaces": [
    "packages/core",
    "packages/win-displays",
    "packages/installer",
    "app"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "npm run build && node scripts/audit-publication.mjs && node scripts/traductions.mjs && node --test \"packages/core/dist/test/*.test.js\"",
    "vpx-schema": "npm run build && node packages/installer/dist/vpx-schema-cli.js",
    "probe": "npm run build && node packages/win-displays/dist/cli.js",
    "sync": "npm run build && node app/dist/sync-cli.js",
    "habillage": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File docs/diagnostic-habillage.ps1",
    "start": "npm run build && electron app",
    "assistant": "npm run build && electron app --assistant",
    "fabriquer": "node scripts/fabriquer.mjs",
    "installeur": "node scripts/fabriquer.mjs --installeur",
    "deployer": "node scripts/fabriquer.mjs --deployer",
    "publier": "node scripts/publier.mjs",
    "envoyer": "node scripts/envoyer-github.mjs",
    "decrire": "node scripts/decrire-github.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "linkedom": "0.18.13",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
