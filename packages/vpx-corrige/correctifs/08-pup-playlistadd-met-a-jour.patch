+// Modified by Cyber Pinball, 2026-11-26 (patched Cyber Pinball 8): playlistadd on an existing playlist updates its order
+void PUPPlaylist::SetRandomize(bool randomize)
+{
+   if (randomize == m_randomize)
+      return;
+   m_randomize = randomize;
+   std::ranges::sort(m_files.begin(), m_files.end());
+   if (m_randomize)
+      std::shuffle(m_files.begin(), m_files.end(), std::mt19937(std::random_device {}()));
+   m_lastIndex = 0;
+}
