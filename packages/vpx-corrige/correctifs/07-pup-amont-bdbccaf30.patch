@@ -0,0 +1,34 @@
+// license:GPLv3+
+
+// Modified by Cyber Pinball, 2026-11-26 (patched Cyber Pinball 8): the PinUP Player plugin of VPX at bdbccaf30, built against the plugin API of VPX 10.8.1-5436.
+// The 5436 host (and the other plugins of its archive) keep their headers: this file supplies the few
+// controller helpers of the newer ControllerPlugin.h that the plugin uses, on top of the 5436 ones.
+
+#pragma once
+
+#include <string_view>
+#include <vector>
+
+namespace PinballPlugin::Controller
+{
+
+template <class T> std::vector<T> GetCtrlItems(const MsgPluginAPI* msgApi, uint32_t endpointId, unsigned int getMsgId) { return ::GetCtrlItems<T>(msgApi, endpointId, getMsgId); }
+
+// Controller game ids are 'namespace::key' (the 5436 PinMAME plugin exposes 'pinmame::<rom>')
+inline std::string_view CtrlGetGameKey(const std::string_view id)
+{
+   const size_t sep = id.find("::");
+   return sep == std::string_view::npos ? id : id.substr(sep + 2);
+}
+
+inline std::string_view CtrlGetGameKey(const char* gameId) { return CtrlGetGameKey(gameId != nullptr ? std::string_view(gameId) : std::string_view()); }
+
+inline std::string_view CtrlGetGameNamespace(const std::string_view id)
+{
+   const size_t sep = id.find("::");
+   return sep == std::string_view::npos ? std::string_view() : id.substr(0, sep);
+}
+
+inline std::string_view CtrlGetGameNamespace(const char* gameId) { return CtrlGetGameNamespace(gameId != nullptr ? std::string_view(gameId) : std::string_view()); }
+
+}
