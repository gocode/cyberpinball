+void PUPLabel::ClearAnimation()
+{
+   std::lock_guard lock(m_mutex);
+   ClearAnimationInternal();
+}
+
+void PUPLabel::ClearAnimationInternal()
+{
+   if (m_animation)
+   {
+      m_animation->Restore();
+      m_animation.reset();
+   }
+}
+
+void PUPLabel::SetScreen(PUPScreen* pScreen)
+{
+   m_pScreen = pScreen;
+   m_yScaleOverride = pScreen ? pScreen->m_labelYScale : 0.f;
+}
+
+float PUPLabel::YScale(const SDL_Rect& rect) const
+{
+   if (!m_pScreen || m_pManager->GetEngine() != PUPManager::Engine::PinUP20)
+      return 1.f;
+   if (m_yScaleOverride > 0.f)
+      return m_yScaleOverride;
+   const bool canvas = m_pScreen->m_labelCanvasW > 0;
+   const float w = static_cast<float>(std::max(canvas ? m_pScreen->m_labelCanvasW : rect.w, 10));
+   const float h = static_cast<float>(std::max(canvas ? m_pScreen->m_labelCanvasH : rect.h, 10));
+   float yScale = (w / 1.7777777f) / h;
+   if (yScale > 0.95f && yScale < 1.05f)
+      yScale = 1.f;
+   if (yScale > 1.5f)
+      yScale = 1.5f;
+   if (h > w)
+      yScale = 1.f;
+   return yScale;
+}
+
+int PUPLabel::EffectiveShadowType() const
+{
+   if (m_shadowType < 0)
+      return 2;
+   if (m_pManager->GetEngine() == PUPManager::Engine::PinUP20)
+      return m_shadowType >= 5 ? 0 : m_shadowType;
+   return std::min(m_shadowType, 2);
+}
+
+float PUPLabel::EffectiveSize() const
+{
+   // PinUP's 'size' key sets TFont.Size in points at 96 dpi, i.e. an em height of 96/72 the
+   // pixel value, while LabelNew 'sz' and 'fonth' set the Windows cell height. Our font
+   // metrics work in cell heights, so convert the em height back through the font's ratio.
+   if (!m_sizeIsPoints || !m_pFont)
+      return m_size;
+   return m_size * (96.f / 72.f) / m_pFont->GetWinScale();
+}
+
+SDL_FPoint PUPLabel::GetShadowOffsetPixels(float fontHeight) const
+{
+   return { m_xOffsetIsPercent ? fontHeight * m_xoffset / 100.f : m_xoffset, m_yOffsetIsPercent ? fontHeight * m_yoffset / 100.f : m_yoffset };
+}
