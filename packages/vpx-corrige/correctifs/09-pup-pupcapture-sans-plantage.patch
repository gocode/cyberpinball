+// Modified by Cyber Pinball, 2026-11-27 (patched Cyber Pinball 9): libpupdmd reads the trigger id of every
+// PupCapture file matching (\d+)\.bmp with std::stoi, which throws std::out_of_range past 2147483647, and narrows
+// every path to the ANSI code page, which throws on other names. Thrown on a plugin thread, either ended VPX with
+// 0xC0000409 when the first DMD frame arrived: The Avengers Pro (avs_170) ships PupCapture/12341241234.bmp.
+// Copies the captures libpupdmd can read to a temporary <copy>/PupCapture and returns <copy>, or an empty path.
+static std::filesystem::path ReadableCaptureCopy(const std::filesystem::path& packPath, const string& romName)
+{
+   std::error_code ec;
+   const std::filesystem::path capture = find_case_insensitive_directory_path(packPath / "PupCapture");
+   if (capture.empty())
+      return {};
+   const std::filesystem::path copy = std::filesystem::temp_directory_path(ec) / "cpvpx-pupcapture" / (romName.empty() ? "pack"s : romName);
+   std::filesystem::remove_all(copy, ec);
+   if (!std::filesystem::create_directories(copy / "PupCapture", ec))
+      return {};
+   const std::regex pattern(R"((\d+)\.bmp)", std::regex_constants::icase);
+   unsigned int kept = 0, skipped = 0;
+   for (const auto& entry : std::filesystem::directory_iterator(capture, ec))
+   {
+      string name;
+      try
+      {
+         name = entry.path().filename().string(); // what libpupdmd does, throws on names outside the ANSI code page
+      }
+      catch (...)
+      {
+         skipped++;
+         continue;
+      }
+      std::smatch matches;
+      if (!std::regex_search(name, matches, pattern))
+         continue;
+      string digits = matches[1].str();
+      digits.erase(0, (std::min)(digits.find_first_not_of('0'), digits.size() - 1));
+      if (digits.size() > 10 || (digits.size() == 10 && digits > "2147483647"))
+      {
+         skipped++;
+         continue;
+      }
+      if (std::filesystem::copy_file(entry.path(), copy / "PupCapture" / entry.path().filename(), std::filesystem::copy_options::overwrite_existing, ec))
+         kept++;
+   }
+   LOGI(std::format("PupCapture: {} capture(s) kept, {} capture(s) skipped because libpupdmd cannot read their name", kept, skipped));
+   return kept ? copy : std::filesystem::path();
+}
