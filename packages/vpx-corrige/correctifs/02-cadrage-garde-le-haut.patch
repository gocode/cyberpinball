    "Manual"s, "Fit Table"s, "Fit Screen"s);
 PropFloat(Player, CabinetAutofitPos, "Cabinet Autofit Pos"s, "Relative lower flipper bat position when using automatic view fitting (0% for bottom of screen, 100% for top)"s, 0.f, 0.2f, 0.05f);
+// Added by Cyber Pinball, 2026-11-21 (patched Cyber Pinball 2): 'Fit Table' without hiding the top of the table.
+PropBool(Player, CabinetAutofitKeepTop, "Cabinet Autofit Keep Top"s, "With 'Fit Table': never hide the top of the table. The table is zoomed only until its top reaches the top of the screen with the lower flipper bats at the selected position (hiding the apron), the remaining width is filled by a limited horizontal stretch"s, false);
+PropFloat(Player, CabinetAutofitMaxStretch, "Cabinet Autofit Max Stretch"s, "With 'Fit Table' and 'Keep Top': maximum horizontal stretch used to fill the screen width (0% keeps the table proportions, leaving side bands)"s, 0.f, 0.5f, 0.f);
 
