+// Modified by Cyber Pinball, 2026-11-22 (patched Cyber Pinball 4): summary of the GPU frame lengths in the log,
+// every minute ("running") and when the render loop ends ("end", whole game), with the playfield frame budget, so a
+// frontend can fit the graphics settings to what the GPU actually does.
+namespace
+{
+struct GpuFrameSummary
+{
+   std::array<uint32_t, 401> buckets {}; // 0.25 ms buckets up to 100 ms, the last one for longer frames
+   uint64_t count = 0;
+   uint64_t total = 0;
+   uint64_t longest = 0;
+
+   void Add(const uint64_t us)
+   {
+      buckets[std::min<uint64_t>(us / 250, buckets.size() - 1)]++;
+      count++;
+      total += us;
+      longest = std::max(longest, us);
+   }
+
+   double Percentile(const double p) const
+   {
+      const uint64_t rank = static_cast<uint64_t>(p * static_cast<double>(count - 1));
+      uint64_t seen = 0;
+      for (size_t i = 0; i < buckets.size(); i++)
+      {
+         seen += buckets[i];
+         if (seen > rank)
+            return (static_cast<double>(i) + 0.5) * 0.25;
+      }
+      return static_cast<double>(longest) / 1000.0;
+   }
+
+   void Log(const char* const what, const float refreshRate)
+   {
+      if (count == 0)
+         return;
+      PLOGI << std::format("GPU frame {}: frames={} mean={:.2f}ms p50={:.2f}ms p95={:.2f}ms max={:.2f}ms budget={:.2f}ms", what, count,
+         static_cast<double>(total) / static_cast<double>(count) / 1000.0, Percentile(0.50), Percentile(0.95), static_cast<double>(longest) / 1000.0,
+         refreshRate > 0.f ? 1000.0 / refreshRate : 0.0);
+   }
+};
+}
