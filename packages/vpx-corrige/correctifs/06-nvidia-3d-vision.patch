+#if BX_PLATFORM_WINDOWS && !defined(__STANDALONE__)
+////////////////////////////////////////////////////////////////////////////////
+// Added by Cyber Pinball, 2026-11-24 (patched Cyber Pinball 7): NVIDIA 3D Vision direct mode.
+//
+// 3D Vision (NVIDIA driver 452.06 or older for Direct3D 11) needs a Direct3D 11 device, an exclusive fullscreen
+// swapchain, and NvAPI_Stereo_SetDriverMode(DIRECT) called before the device is created (done in the RenderDevice
+// constructor). BGFX does not implement exclusive fullscreen, so the device and the swapchain are created here and
+// given to BGFX, which renders headless into an offscreen side by side target (left view, right view, each at the
+// full window width) used as its backbuffer. On each present, each half is drawn to the stereo backbuffer after
+// selecting the eye with NvAPI_Stereo_SetActiveEye, in a separate device context state so that BGFX's state is
+// left untouched. Everything here runs on the render thread (the only BGFX thread), except the driver mode.
+// Surfaces created after the swapchain are forced mono (only the swapchain backbuffer is stereo).
+
+struct NvStereoDirect
+{
+   HWND hwnd = nullptr;
+   UINT width = 0;
+   UINT height = 0;
+   DXGI_MODE_DESC mode {};
+   ID3D11Device* device = nullptr;
+   ID3D11DeviceContext* context = nullptr;
+   ID3D11DeviceContext1* context1 = nullptr;
+   ID3DDeviceContextState* state = nullptr;
+   IDXGIOutput* output = nullptr;
+   IDXGISwapChain* swapChain = nullptr;
+   ID3D11RenderTargetView* backBufferRTV = nullptr;
+   ID3D11Texture2D* sbsTex = nullptr;
+   ID3D11RenderTargetView* sbsRTV = nullptr;
+   ID3D11ShaderResourceView* sbsSRV = nullptr;
+   ID3D11Texture2D* depthTex = nullptr;
+   ID3D11DepthStencilView* depthDSV = nullptr;
+   ID3D11VertexShader* vs[3] = { nullptr, nullptr, nullptr }; // left half, right half, whole side by side target
+   ID3D11PixelShader* ps = nullptr;
+   ID3D11SamplerState* sampler = nullptr;
+   StereoHandle stereo = nullptr;
+   std::atomic<bool> stopping { false }; // set by the main thread when the player closes: no more fullscreen switch
+   ULONGLONG nextFullscreenTry = 0;
+   unsigned int presentCount = 0;
+   int lastActivated = -1;
+   bool fullscreen = false;
+   bool presentErrorLogged = false;
+   bool eyeErrorLogged = false;
+};
+
+template <class T> static void NvStereoRelease(T*& p)
+{
+   if (p)
+   {
+      p->Release();
+      p = nullptr;
+   }
+}
+
+static void NvStereoDestroy(NvStereoDirect*& s)
+{
+   if (s == nullptr)
+      return;
+   if (s->swapChain)
+   {
+      // A swapchain must leave exclusive fullscreen before being released
+      BOOL fullscreen = FALSE;
+      if (SUCCEEDED(s->swapChain->GetFullscreenState(&fullscreen, nullptr)) && fullscreen)
+         s->swapChain->SetFullscreenState(FALSE, nullptr);
+   }
+   if (s->stereo)
+      NvAPI_Stereo_DestroyHandle(s->stereo);
+   NvStereoRelease(s->sampler);
+   NvStereoRelease(s->ps);
+   for (auto& vs : s->vs)
+      NvStereoRelease(vs);
+   NvStereoRelease(s->depthDSV);
+   NvStereoRelease(s->depthTex);
+   NvStereoRelease(s->sbsSRV);
+   NvStereoRelease(s->sbsRTV);
+   NvStereoRelease(s->sbsTex);
+   NvStereoRelease(s->backBufferRTV);
+   NvStereoRelease(s->swapChain);
+   NvStereoRelease(s->output);
+   NvStereoRelease(s->state);
+   NvStereoRelease(s->context1);
+   NvStereoRelease(s->context);
+   NvStereoRelease(s->device);
+   delete s;
+   s = nullptr;
+}
+
+static void NvStereoStop(NvStereoDirect* s)
+{
+   s->stopping = true;
+}
+
+static bool NvStereoBindBackBuffer(NvStereoDirect* s)
+{
+   ID3D11Texture2D* backBuffer = nullptr;
+   if (FAILED(s->swapChain->GetBuffer(0, __uuidof(ID3D11Texture2D), (void**)&backBuffer)))
+      return false;
+   const HRESULT hr = s->device->CreateRenderTargetView(backBuffer, nullptr, &s->backBufferRTV);
+   backBuffer->Release();
+   return SUCCEEDED(hr);
+}
+
+// Exclusive fullscreen is required by 3D Vision with Direct3D 11 on GeForce cards. The backbuffer is recreated with
+// automatic surface creation so that the driver makes it stereo, then surface creation is forced mono again.
+// Returns true when the swapchain is in exclusive fullscreen with its backbuffer bound. Otherwise the backbuffer
+// stays bound (when possible) in a window, where the whole side by side target is presented.
+static bool NvStereoEnterFullscreen(NvStereoDirect* s)
+{
+   NvStereoRelease(s->backBufferRTV);
+   NvAPI_Stereo_SetSurfaceCreationMode(s->stereo, NVAPI_STEREO_SURFACECREATEMODE_AUTO);
+   s->swapChain->ResizeTarget(&s->mode);
+   HRESULT hr = s->swapChain->SetFullscreenState(TRUE, s->output);
+   if (SUCCEEDED(hr))
+      hr = s->swapChain->ResizeBuffers(1, s->width, s->height, s->mode.Format, DXGI_SWAP_CHAIN_FLAG_ALLOW_MODE_SWITCH);
+   NvAPI_Stereo_SetSurfaceCreationMode(s->stereo, NVAPI_STEREO_SURFACECREATEMODE_FORCEMONO);
+   BOOL fullscreen = FALSE;
+   s->swapChain->GetFullscreenState(&fullscreen, nullptr);
+   s->fullscreen = SUCCEEDED(hr) && fullscreen;
+   if (!s->fullscreen)
+      PLOGE << "NVIDIA 3D Vision: exclusive fullscreen failed (0x" << std::hex << (uint32_t)hr << std::dec << "), showing both views side by side until the playfield window is in front again";
+   else
+      PLOGI << "NVIDIA 3D Vision: exclusive fullscreen " << s->mode.Width << 'x' << s->mode.Height << " at " << s->mode.RefreshRate.Numerator << '/' << s->mode.RefreshRate.Denominator << " Hz";
+   if (!NvStereoBindBackBuffer(s))
+   {
+      PLOGE << "NVIDIA 3D Vision: failed to bind the swapchain backbuffer";
+      return false;
+   }
+   return s->fullscreen;
+}
+
+static const char nvStereoShader[] = R"(
+struct VSOut { float4 pos : SV_Position; float2 uv : TEXCOORD0; };
+VSOut vs_main(uint id : SV_VertexID)
+{
+   VSOut o;
+   const float2 t = float2((id << 1) & 2, id & 2);
+   o.pos = float4(t * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+   o.uv = float2(EYE_OFFSET + t.x * EYE_SCALE, t.y);
+   return o;
+}
+Texture2D tex : register(t0);
+SamplerState smp : register(s0);
+float4 ps_main(VSOut i) : SV_Target { return float4(tex.Sample(smp, i.uv).rgb, 1.0); }
+)";
+
+static NvStereoDirect* NvStereoCreate(HWND hwnd, UINT width, UINT height)
+{
+   NvStereoDirect* s = new NvStereoDirect();
+   s->hwnd = hwnd;
+   const auto fail = [&s](const char* what, long code) -> NvStereoDirect*
+   {
+      PLOGE << "NVIDIA 3D Vision: " << what << " failed (0x" << std::hex << (uint32_t)code << std::dec << "), falling back to plain side by side rendering";
+      NvStereoDestroy(s);
+      return nullptr;
+   };
+
+   // Device on the default adapter (the one driving the main display), Direct3D 11 only
+   static PFN_D3D11_CREATE_DEVICE createDevice = nullptr;
+   if (createDevice == nullptr)
+      if (HMODULE d3d11 = LoadLibraryW(L"d3d11.dll"); d3d11)
+         createDevice = (PFN_D3D11_CREATE_DEVICE)GetProcAddress(d3d11, "D3D11CreateDevice");
+   if (createDevice == nullptr)
+      return fail("loading Direct3D 11", E_FAIL);
+   const D3D_FEATURE_LEVEL levels[] = { D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0 };
+   HRESULT hr = createDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, D3D11_CREATE_DEVICE_BGRA_SUPPORT, levels, 2, D3D11_SDK_VERSION, &s->device, nullptr, &s->context);
+   if (hr == E_INVALIDARG)
+      hr = createDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, D3D11_CREATE_DEVICE_BGRA_SUPPORT, levels + 1, 1, D3D11_SDK_VERSION, &s->device, nullptr, &s->context);
+   if (FAILED(hr))
+      return fail("D3D11CreateDevice", hr);
+   if (FAILED(hr = s->context->QueryInterface(__uuidof(ID3D11DeviceContext1), (void**)&s->context1)))
+      return fail("ID3D11DeviceContext1", hr);
+
+   // Output of the playfield window, which must be driven by that adapter
+   IDXGIDevice* dxgiDevice = nullptr;
+   IDXGIAdapter* adapter = nullptr;
+   IDXGIFactory* factory = nullptr;
+   hr = s->device->QueryInterface(__uuidof(IDXGIDevice), (void**)&dxgiDevice);
+   if (SUCCEEDED(hr))
+      hr = dxgiDevice->GetAdapter(&adapter);
+   if (SUCCEEDED(hr))
+      hr = adapter->GetParent(__uuidof(IDXGIFactory), (void**)&factory);
+   NvStereoRelease(dxgiDevice);
+   if (FAILED(hr))
+   {
+      NvStereoRelease(adapter);
+      return fail("getting the DXGI factory", hr);
+   }
+   const HMONITOR monitor = MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST);
+   IDXGIOutput* output = nullptr;
+   for (UINT i = 0; adapter->EnumOutputs(i, &output) != DXGI_ERROR_NOT_FOUND; ++i)
+   {
+      DXGI_OUTPUT_DESC desc;
+      if (SUCCEEDED(output->GetDesc(&desc)) && desc.Monitor == monitor)
+      {
+         s->output = output;
+         break;
+      }
+      NvStereoRelease(output);
+   }
+   NvStereoRelease(adapter);
+   if (s->output == nullptr)
+   {
+      NvStereoRelease(factory);
+      return fail("finding the playfield display on the main graphics adapter (the playfield must be the main display)", DXGI_ERROR_NOT_FOUND);
+   }
+
+   // Display mode: the window size at the current refresh rate of the playfield display
+   UINT refreshRate = 0;
+   MONITORINFOEXW monitorInfo {};
+   monitorInfo.cbSize = sizeof(monitorInfo);
+   DEVMODEW displayMode {};
+   displayMode.dmSize = sizeof(displayMode);
+   if (GetMonitorInfoW(monitor, &monitorInfo) && EnumDisplaySettingsW(monitorInfo.szDevice, ENUM_CURRENT_SETTINGS, &displayMode))
+      refreshRate = displayMode.dmDisplayFrequency;
+   DXGI_MODE_DESC wanted {};
+   wanted.Width = width;
+   wanted.Height = height;
+   wanted.RefreshRate.Numerator = refreshRate;
+   wanted.RefreshRate.Denominator = refreshRate ? 1 : 0;
+   wanted.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+   if (FAILED(hr = s->output->FindClosestMatchingMode(&wanted, &s->mode, s->device)))
+   {
+      NvStereoRelease(factory);
+      return fail("finding a fullscreen display mode", hr);
+   }
+   s->width = s->mode.Width;
+   s->height = s->mode.Height;
+
+   // Swapchain (its backbuffer is made stereo by the driver), then the stereo handle
+   DXGI_SWAP_CHAIN_DESC scd {};
+   scd.BufferDesc = s->mode;
+   scd.SampleDesc.Count = 1;
+   scd.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+   scd.BufferCount = 1;
+   scd.OutputWindow = hwnd;
+   scd.Windowed = TRUE;
+   scd.SwapEffect = DXGI_SWAP_EFFECT_DISCARD;
+   scd.Flags = DXGI_SWAP_CHAIN_FLAG_ALLOW_MODE_SWITCH;
+   hr = factory->CreateSwapChain(s->device, &scd, &s->swapChain);
+   if (SUCCEEDED(hr))
+      factory->MakeWindowAssociation(hwnd, DXGI_MWA_NO_ALT_ENTER);
+   NvStereoRelease(factory);
+   if (FAILED(hr))
+      return fail("CreateSwapChain", hr);
+   if (const NvAPI_Status status = NvAPI_Stereo_CreateHandleFromIUnknown(s->device, &s->stereo); status != NVAPI_OK)
+      return fail("NvAPI_Stereo_CreateHandleFromIUnknown", status);
+   // The playfield window may not be in front yet: while windowed, both views are shown side by side, and
+   // exclusive fullscreen is tried again once the window is in front (see NvStereoPresent)
+   NvStereoEnterFullscreen(s);
+   if (s->backBufferRTV == nullptr)
+      return fail("binding the swapchain backbuffer", E_FAIL);
+
+   // Side by side target and depth buffer given to BGFX as its backbuffer (mono surfaces)
+   D3D11_TEXTURE2D_DESC td {};
+   td.Width = s->width * 2;
+   td.Height = s->height;
+   td.MipLevels = 1;
+   td.ArraySize = 1;
+   td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+   td.SampleDesc.Count = 1;
+   td.Usage = D3D11_USAGE_DEFAULT;
+   td.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+   if (FAILED(hr = s->device->CreateTexture2D(&td, nullptr, &s->sbsTex))
+      || FAILED(hr = s->device->CreateRenderTargetView(s->sbsTex, nullptr, &s->sbsRTV))
+      || FAILED(hr = s->device->CreateShaderResourceView(s->sbsTex, nullptr, &s->sbsSRV)))
+      return fail("creating the side by side target", hr);
+   td.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
+   td.BindFlags = D3D11_BIND_DEPTH_STENCIL;
+   if (FAILED(hr = s->device->CreateTexture2D(&td, nullptr, &s->depthTex))
+      || FAILED(hr = s->device->CreateDepthStencilView(s->depthTex, nullptr, &s->depthDSV)))
+      return fail("creating the depth buffer", hr);
+
+   // Shaders drawing one half of the side by side target (or all of it, while windowed) to the whole backbuffer
+   static pD3DCompile compile = nullptr;
+   if (compile == nullptr)
+      if (HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll"); compiler)
+         compile = (pD3DCompile)GetProcAddress(compiler, "D3DCompile");
+   if (compile == nullptr)
+      return fail("loading d3dcompiler_47.dll", E_FAIL);
+   for (int i = 0; i < 4; i++)
+   {
+      const bool vertex = i < 3;
+      const D3D_SHADER_MACRO defines[] = { { "EYE_OFFSET", i == 1 ? "0.5" : "0.0" }, { "EYE_SCALE", i == 2 ? "1.0" : "0.5" }, { nullptr, nullptr } };
+      ID3DBlob* code = nullptr;
+      ID3DBlob* errors = nullptr;
+      hr = compile(nvStereoShader, sizeof(nvStereoShader) - 1, "NvStereoDirect", defines, nullptr, vertex ? "vs_main" : "ps_main", vertex ? "vs_5_0" : "ps_5_0", 0, 0, &code, &errors);
+      if (SUCCEEDED(hr))
+         hr = vertex ? s->device->CreateVertexShader(code->GetBufferPointer(), code->GetBufferSize(), nullptr, &s->vs[i])
+                     : s->device->CreatePixelShader(code->GetBufferPointer(), code->GetBufferSize(), nullptr, &s->ps);
+      if (errors)
+         PLOGE << "NVIDIA 3D Vision: " << (const char*)errors->GetBufferPointer();
+      NvStereoRelease(code);
+      NvStereoRelease(errors);
+      if (FAILED(hr))
+         return fail("compiling the present shaders", hr);
+   }
+   D3D11_SAMPLER_DESC sd {};
+   sd.Filter = D3D11_FILTER_MIN_MAG_MIP_POINT; // 1:1 texel to pixel mapping
+   sd.AddressU = sd.AddressV = sd.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+   sd.ComparisonFunc = D3D11_COMPARISON_NEVER;
+   sd.MaxLOD = D3D11_FLOAT32_MAX;
+   if (FAILED(hr = s->device->CreateSamplerState(&sd, &s->sampler)))
+      return fail("CreateSamplerState", hr);
+
+   // Separate device context state, swapped in only while presenting
+   ID3D11Device1* device1 = nullptr;
+   hr = s->device->QueryInterface(__uuidof(ID3D11Device1), (void**)&device1);
+   if (SUCCEEDED(hr))
+   {
+      const D3D_FEATURE_LEVEL level = s->device->GetFeatureLevel();
+      hr = device1->CreateDeviceContextState(0, &level, 1, D3D11_SDK_VERSION, __uuidof(ID3D11Device), nullptr, &s->state);
+   }
+   NvStereoRelease(device1);
+   if (FAILED(hr))
+      return fail("CreateDeviceContextState", hr);
+
+   PLOGI << "NVIDIA 3D Vision: direct mode ready, " << s->width << 'x' << s->height << " per eye";
+   return s;
+}
+
+static void NvStereoPresent(NvStereoDirect* s)
+{
+   // Exclusive fullscreen is lost when another window takes the focus: take it back once the playfield is in front again
+   // (never while the player is closing: the main thread is then waiting for this thread, see ~RenderDevice)
+   BOOL fullscreen = FALSE;
+   s->swapChain->GetFullscreenState(&fullscreen, nullptr);
+   if (s->fullscreen && !fullscreen)
+   {
+      s->fullscreen = false;
+      PLOGI << "NVIDIA 3D Vision: exclusive fullscreen lost, showing both views side by side until the playfield window is in front again";
+   }
+   if (!fullscreen && !s->stopping && GetForegroundWindow() == s->hwnd && GetTickCount64() >= s->nextFullscreenTry)
+   {
+      s->nextFullscreenTry = GetTickCount64() + 2000;
+      NvStereoEnterFullscreen(s);
+   }
+   if (s->backBufferRTV == nullptr)
+      return;
+
+   ID3DDeviceContextState* bgfxState = nullptr;
+   s->context1->SwapDeviceContextState(s->state, &bgfxState);
+   const D3D11_VIEWPORT viewport = { 0.f, 0.f, (float)s->width, (float)s->height, 0.f, 1.f };
+   s->context->OMSetRenderTargets(1, &s->backBufferRTV, nullptr);
+   s->context->RSSetViewports(1, &viewport);
+   s->context->IASetInputLayout(nullptr);
+   s->context->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+   s->context->PSSetShader(s->ps, nullptr, 0);
+   s->context->PSSetShaderResources(0, 1, &s->sbsSRV);
+   s->context->PSSetSamplers(0, 1, &s->sampler);
+   // Each eye selected then drawn; without fullscreen, or if the driver refuses an eye, the whole side by side
+   // target is drawn instead (a single mono view would otherwise replace the other one)
+   bool stereoPresent = s->fullscreen;
+   for (int eye = 0; eye < 2 && stereoPresent; eye++)
+   {
+      const NvAPI_Status status = NvAPI_Stereo_SetActiveEye(s->stereo, eye == 0 ? NVAPI_STEREO_EYE_LEFT : NVAPI_STEREO_EYE_RIGHT);
+      if (status != NVAPI_OK)
+      {
+         stereoPresent = false;
+         if (!s->eyeErrorLogged)
+         {
+            s->eyeErrorLogged = true;
+            PLOGE << "NVIDIA 3D Vision: NvAPI_Stereo_SetActiveEye error " << (int)status << ", showing both views side by side";
+         }
+         break;
+      }
+      s->context->VSSetShader(s->vs[eye], nullptr, 0);
+      s->context->Draw(3, 0);
+   }
+   if (!stereoPresent)
+   {
+      if (s->fullscreen)
+         NvAPI_Stereo_SetActiveEye(s->stereo, NVAPI_STEREO_EYE_MONO);
+      s->context->VSSetShader(s->vs[2], nullptr, 0);
+      s->context->Draw(3, 0);
+   }
+   ID3D11ShaderResourceView* const noSRV = nullptr;
+   s->context->PSSetShaderResources(0, 1, &noSRV);
+   s->context->OMSetRenderTargets(0, nullptr, nullptr);
+   s->context1->SwapDeviceContextState(bgfxState, nullptr);
+   NvStereoRelease(bgfxState);
+
+   const HRESULT hr = s->swapChain->Present(1, 0);
+   if (FAILED(hr) && !s->presentErrorLogged)
+   {
+      s->presentErrorLogged = true;
+      PLOGE << "NVIDIA 3D Vision: Present failed (0x" << std::hex << (uint32_t)hr << std::dec << ')';
+   }
+   if ((s->presentCount++ % 120) == 0)
+   {
+      NvU8 activated = 0;
+      if (NvAPI_Stereo_IsActivated(s->stereo, &activated) == NVAPI_OK && (int)activated != s->lastActivated)
+      {
+         s->lastActivated = activated;
+         PLOGI << "NVIDIA 3D Vision: stereo " << (activated ? "activated" : "not activated (check the glasses, the emitter and the NVIDIA control panel, Ctrl+T toggles it)");
+      }
+   }
+}
