+// Modified by Cyber Pinball, 2026-11-28 (patched Cyber Pinball 10): where the logic thread spends each frame, one
+// "Logic live" line per second while playing: frames, late frames (longer than 1.5 refresh periods) and the mean
+// time per frame in each profiler section (script, physics, prepare frame, plugins' prepare-frame callbacks, misc,
+// sleep), over all frames and over the late ones, so a frontend can tell what makes a table miss frames.
+namespace
+{
+struct LogicLiveStats
+{
+   enum Part { SCRIPT, PHYSICS, PREPARE, PLUGINS, MISC, SLEEP, PARTS };
+   uint64_t start = 0;
+   uint64_t lastFrame = 0;
+   uint32_t frames = 0, late = 0;
+   uint64_t all[PARTS] {}, slow[PARTS] {};
+   uint64_t scriptMax = 0, physicsMax = 0, frameMax = 0;
+   uint64_t pluginsUs = 0; // the plugins' prepare-frame callbacks of the frame being prepared
+
+   void Frame(const FrameProfiler& p, const float refreshRate, const bool playing)
+   {
+      const uint64_t now = usec();
+      if (lastFrame != 0 && playing)
+      {
+         const uint64_t length = now - lastFrame;
+         const uint64_t prepare = p.Get(FrameProfiler::PROFILE_PREPARE_FRAME);
+         const uint64_t parts[PARTS] = { p.Get(FrameProfiler::PROFILE_SCRIPT), p.Get(FrameProfiler::PROFILE_PHYSICS), prepare > pluginsUs ? prepare - pluginsUs : 0, pluginsUs,
+            p.Get(FrameProfiler::PROFILE_MISC), p.Get(FrameProfiler::PROFILE_SLEEP) };
+         const bool isLate = refreshRate > 0.f && static_cast<double>(length) > 1.5e6 / static_cast<double>(refreshRate);
+         frames++;
+         if (isLate)
+            late++;
+         for (int i = 0; i < PARTS; i++)
+         {
+            all[i] += parts[i];
+            if (isLate)
+               slow[i] += parts[i];
+         }
+         scriptMax = std::max(scriptMax, parts[SCRIPT]);
+         physicsMax = std::max(physicsMax, parts[PHYSICS]);
+         frameMax = std::max(frameMax, length);
+      }
+      lastFrame = now;
+      pluginsUs = 0;
+      if (start == 0)
+         start = now;
+      if (now - start < 1000000ull)
+         return;
+      if (frames != 0)
+      {
+         const auto mean = [](const uint64_t total, const uint32_t n) { return n ? static_cast<double>(total) / static_cast<double>(n) / 1000.0 : 0.0; };
+         PLOGI << std::format("Logic live: frames={} late={} max={:.1f}ms | all: script={:.2f} physics={:.2f} prepare={:.2f} plugins={:.2f} misc={:.2f} sleep={:.2f}"
+                              " | late: script={:.2f} physics={:.2f} prepare={:.2f} plugins={:.2f} misc={:.2f} sleep={:.2f} | script max={:.1f}ms physics max={:.1f}ms",
+            frames, late, static_cast<double>(frameMax) / 1000.0, mean(all[SCRIPT], frames), mean(all[PHYSICS], frames), mean(all[PREPARE], frames), mean(all[PLUGINS], frames),
+            mean(all[MISC], frames), mean(all[SLEEP], frames), mean(slow[SCRIPT], late), mean(slow[PHYSICS], late), mean(slow[PREPARE], late), mean(slow[PLUGINS], late),
+            mean(slow[MISC], late), mean(slow[SLEEP], late), static_cast<double>(scriptMax) / 1000.0, static_cast<double>(physicsMax) / 1000.0);
+      }
+      const uint64_t keepLast = lastFrame;
+      *this = LogicLiveStats();
+      start = now;
+      lastFrame = keepLast;
+   }
+};
+LogicLiveStats g_logicLive;
+}
