+// Modified by Cyber Pinball, 2026-11-28 (patched Cyber Pinball 10): where the render thread spends each frame, one
+// "Render live" line per second: frames, late frames (more than 1.5 refresh periods between two presents), the GPU
+// frame length (mean, max, frames over the refresh period) and the mean time per frame in each render profiler
+// section, over all frames and over the late ones. Read with the "Logic live" line of the logic thread (player.cpp).
+struct RenderLiveStats
+{
+   enum Part { WAIT, WAIT_SC, SUBMIT, FLIP, SLEEP, PARTS };
+   uint64_t start = 0;
+   uint64_t lastPresent = 0;
+   uint32_t frames = 0, late = 0;
+   uint64_t all[PARTS] {}, slow[PARTS] {};
+   uint32_t gpuFrames = 0, gpuOver = 0;
+   uint64_t gpuTotal = 0, gpuMax = 0;
+
+   void Gpu(const uint64_t us, const float refreshRate)
+   {
+      gpuFrames++;
+      gpuTotal += us;
+      gpuMax = std::max(gpuMax, us);
+      if (refreshRate > 0.f && static_cast<double>(us) > 1e6 / static_cast<double>(refreshRate))
+         gpuOver++;
+   }
+
+   void Frame(const FrameProfiler& p, const uint64_t present, const float refreshRate)
+   {
+      if (lastPresent != 0)
+      {
+         const bool isLate = refreshRate > 0.f && static_cast<double>(present - lastPresent) > 1.5e6 / static_cast<double>(refreshRate);
+         const uint64_t parts[PARTS] = { p.Get(FrameProfiler::PROFILE_RENDER_WAIT), p.Get(FrameProfiler::PROFILE_RENDER_WAIT_SC), p.Get(FrameProfiler::PROFILE_RENDER_SUBMIT),
+            p.Get(FrameProfiler::PROFILE_RENDER_FLIP), p.Get(FrameProfiler::PROFILE_RENDER_SLEEP) };
+         frames++;
+         if (isLate)
+            late++;
+         for (int i = 0; i < PARTS; i++)
+         {
+            all[i] += parts[i];
+            if (isLate)
+               slow[i] += parts[i];
+         }
+      }
+      lastPresent = present;
+      if (start == 0)
+         start = present;
+      if (present - start < 1000000ull)
+         return;
+      if (frames != 0)
+      {
+         const auto mean = [](const uint64_t total, const uint32_t n) { return n ? static_cast<double>(total) / static_cast<double>(n) / 1000.0 : 0.0; };
+         PLOGI << std::format("Render live: frames={} late={} gpu={:.2f}ms gpu max={:.1f}ms gpu over={} | all: wait={:.2f} waitsc={:.2f} submit={:.2f} flip={:.2f} sleep={:.2f}"
+                              " | late: wait={:.2f} waitsc={:.2f} submit={:.2f} flip={:.2f} sleep={:.2f}",
+            frames, late, mean(gpuTotal, gpuFrames), static_cast<double>(gpuMax) / 1000.0, gpuOver, mean(all[WAIT], frames), mean(all[WAIT_SC], frames),
+            mean(all[SUBMIT], frames), mean(all[FLIP], frames), mean(all[SLEEP], frames), mean(slow[WAIT], late), mean(slow[WAIT_SC], late), mean(slow[SUBMIT], late),
+            mean(slow[FLIP], late), mean(slow[SLEEP], late));
+      }
+      const uint64_t keepLast = lastPresent;
+      *this = RenderLiveStats();
+      start = present;
+      lastPresent = keepLast;
+   }
+};
 }
 
