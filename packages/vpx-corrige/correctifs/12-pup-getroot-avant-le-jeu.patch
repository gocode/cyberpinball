+std::filesystem::path PUPManager::GetTablePupRoot() const
+{
+   if (m_vpxApi == nullptr)
+      return {};
+   VPXTableInfo tableInfo {};
+   m_vpxApi->GetTableInfo(&tableInfo);
+   if (tableInfo.path == nullptr || *tableInfo.path == 0)
+      return {};
+   return find_case_insensitive_directory_path(PluginStrings::PathFromNative(tableInfo.path).parent_path() / "pupvideos"sv);
+}
