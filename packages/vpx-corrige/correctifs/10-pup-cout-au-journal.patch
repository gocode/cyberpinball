+// Modified by Cyber Pinball, 2026-11-28 (patched Cyber Pinball 10): cost of the PuP videos, one "PuP live" line per second in the log while videos play.
+// Render thread: texture uploads (count, MB, time, longest) and time spent in Render (lock waits included).
+// Decoder threads: frames converted to RGBA (count, time), and those converted for a screen not rendered for 1 s.
+namespace
+{
+   struct PupLiveStats
+   {
+      std::atomic<uint64_t> uploads { 0 }, uploadBytes { 0 }, uploadNs { 0 }, uploadMaxNs { 0 }, renderNs { 0 };
+      std::atomic<uint64_t> converted { 0 }, convertNs { 0 }, unseen { 0 };
+      std::atomic<uint64_t> nextLogTicks { 0 };
+   };
+   PupLiveStats g_pupLive;
+
+   void PupLiveMax(std::atomic<uint64_t>& a, uint64_t v)
+   {
+      uint64_t c = a.load(std::memory_order_relaxed);
+      while (v > c && !a.compare_exchange_weak(c, v, std::memory_order_relaxed)) { }
+   }
+
+   void PupLiveTick()
+   {
+      const uint64_t now = SDL_GetTicks();
+      uint64_t next = g_pupLive.nextLogTicks.load(std::memory_order_relaxed);
+      if (next == 0)
+      {
+         g_pupLive.nextLogTicks.compare_exchange_strong(next, now + 1000);
+         return;
+      }
+      if (now < next || !g_pupLive.nextLogTicks.compare_exchange_strong(next, now + 1000))
+         return;
+      const uint64_t uploads = g_pupLive.uploads.exchange(0), bytes = g_pupLive.uploadBytes.exchange(0), uploadNs = g_pupLive.uploadNs.exchange(0),
+                     maxNs = g_pupLive.uploadMaxNs.exchange(0), renderNs = g_pupLive.renderNs.exchange(0), converted = g_pupLive.converted.exchange(0),
+                     convertNs = g_pupLive.convertNs.exchange(0), unseen = g_pupLive.unseen.exchange(0);
+      if (uploads == 0 && converted == 0)
+         return;
+      LOGI(std::format("PuP live: uploads={} MB={:.1f} upload={:.1f}ms max={:.2f}ms render={:.1f}ms converted={} convert={:.1f}ms unseen={}", uploads,
+         static_cast<double>(bytes) / 1e6, static_cast<double>(uploadNs) / 1e6, static_cast<double>(maxNs) / 1e6, static_cast<double>(renderNs) / 1e6, converted,
+         static_cast<double>(convertNs) / 1e6, unseen));
+   }
+
+   struct PupLiveRenderScope
+   {
+      const uint64_t start = SDL_GetTicksNS();
+      ~PupLiveRenderScope() { g_pupLive.renderNs.fetch_add(SDL_GetTicksNS() - start, std::memory_order_relaxed); }
+   };
+
+   void PupLiveUpload(VPXTexture* texture, int width, int height, const void* image)
+   {
+      const uint64_t start = SDL_GetTicksNS();
+      UpdateTexture(texture, width, height, VPXTextureFormat::VPXTEXFMT_sRGBA8, image);
+      const uint64_t ns = SDL_GetTicksNS() - start;
+      g_pupLive.uploads.fetch_add(1, std::memory_order_relaxed);
+      g_pupLive.uploadBytes.fetch_add(static_cast<uint64_t>(width) * height * 4, std::memory_order_relaxed);
+      g_pupLive.uploadNs.fetch_add(ns, std::memory_order_relaxed);
+      PupLiveMax(g_pupLive.uploadMaxNs, ns);
+   }
+}
